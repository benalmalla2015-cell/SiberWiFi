# CyberNet RADIUS stack — copy to .env on the VPS and fill in.

# Backend bridge: the engine POSTs auth/acct events to this URL.
# Example: https://api.example.com/api/cyber/radius/events
CYBER_ENGINE_URL=

# Bearer token the backend uses to authenticate engine calls.
CYBER_ENGINE_TOKEN=

# Timezone inside containers (default: Asia/Aden).
TZ=Asia/Aden

# Engine tuning (optional — defaults shown).
# ENGINE_POLL_INTERVAL=5     # seconds between ledger scans
# ENGINE_BATCH_MAX=200       # max events per POST
# ENGINE_HTTP_TIMEOUT=15     # seconds per POST
