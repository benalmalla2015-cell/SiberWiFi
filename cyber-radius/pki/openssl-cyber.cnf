# =============================================================================
# CyberNet private CA — OpenSSL configuration
# Used by init-ca.sh / pki/scripts/*.sh via: openssl ca -config <this file>
# Paths are relative to pki/ca/ (scripts cd there or pass -config with env).
# =============================================================================

[ ca ]
default_ca = CYBER_CA

[ CYBER_CA ]
dir               = ./pki/ca
certs             = $dir
new_certs_dir     = $dir/newcerts
database          = $dir/index.txt
serial            = $dir/serial
crlnumber         = $dir/crlnumber
certificate       = $dir/ca.crt
private_key       = $dir/private/ca.key
default_md        = sha256
default_days      = 825            # subscriber certs: ~27 months
default_crl_days  = 30
preserve          = no
unique_subject    = no
policy            = policy_cyber
copy_extensions   = none
x509_extensions   = client_cert

[ policy_cyber ]
countryName             = optional
stateOrProvinceName     = optional
localityName            = optional
organizationName        = supplied
organizationalUnitName  = optional
commonName              = supplied
emailAddress            = optional

[ req ]
default_bits        = 4096
default_md          = sha256
distinguished_name  = dn_cyber
string_mask         = utf8only
prompt              = no

[ dn_cyber ]
countryName            = YE
organizationName       = CyberNet
commonName             = CyberNet Root CA

[ ca_cert ]
basicConstraints       = critical, CA:true, pathlen:1
keyUsage               = critical, cRLSign, keyCertSign
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always

[ server_cert ]
basicConstraints       = critical, CA:false
keyUsage               = critical, digitalSignature, keyEncipherment
extendedKeyUsage       = serverAuth
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always
subjectAltName         = DNS:radius.cybernet.local

[ client_cert ]
basicConstraints       = critical, CA:false
keyUsage               = critical, digitalSignature
extendedKeyUsage       = clientAuth
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always
