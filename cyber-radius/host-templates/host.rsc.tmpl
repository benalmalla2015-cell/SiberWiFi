# {{HOST_ID}}
:local T "cyber"
:local SSID "{{SSID}}"
:local NET "{{CYBER_SUBNET}}"
:local GW "{{CYBER_GW_CIDR}}"
:local POOL "{{CYBER_POOL}}"
:local RS "{{RADIUS_IP}}"
:local WGN "{{WG_NET}}"
:local BL "$($T)-block"
:local WGIF "$($T)-wg"

:do {/ip firewall filter remove [find where comment=$T]} on-error={}
:do {/ip firewall nat remove [find where comment=$T]} on-error={}
:do {/ip firewall address-list remove [find where comment=$T]} on-error={}
:do {/ip dhcp-server remove [find where comment=$T]} on-error={}
:do {/ip dhcp-server network remove [find where comment=$T]} on-error={}
:do {/ip pool remove [find where comment=$T]} on-error={}
:do {/ip route remove [find where comment=$T]} on-error={}
:do {/ip address remove [find where comment=$T]} on-error={}
:do {/interface wireless remove [find where comment=$T]} on-error={}
:do {/interface wireless security-profiles remove [find where comment=$T]} on-error={}
:do {/interface wireguard peers remove [find where comment=$T]} on-error={}
:do {/interface wireguard remove [find where comment=$T]} on-error={}
:do {/interface bridge port remove [find where comment=$T]} on-error={}
:do {/interface bridge remove [find where comment=$T]} on-error={}
:do {/interface list member remove [find where comment=$T]} on-error={}
:do {/interface list remove [find where comment=$T]} on-error={}
:do {/radius remove [find where comment=$T]} on-error={}

/interface bridge add name=$T protocol-mode=none comment=$T
/interface list add name=$T comment=$T
/interface list member add list=$T interface=$T comment=$T
/ip address add address=$GW interface=$T comment=$T
/ip pool add name="$($T)-pool" ranges=$POOL comment=$T
/ip dhcp-server add name="$($T)-dhcp" interface=$T address-pool="$($T)-pool" lease-time=1h comment=$T
/ip dhcp-server network add address=$NET gateway=[:pick $GW 0 [:find $GW "/"]] dns-server=1.1.1.1,8.8.8.8 comment=$T

/interface wireguard add name=$WGIF listen-port={{WG_LISTEN_PORT}} private-key="{{WG_PRIVATE_KEY}}" comment=$T
/interface wireguard peers add interface=$WGIF public-key="{{WG_SERVER_PUBKEY}}" endpoint-address="{{WG_ENDPOINT}}" endpoint-port={{WG_ENDPOINT_PORT}} allowed-address=$WGN persistent-keepalive=25s comment=$T
/ip address add address={{WG_HOST_IP_CIDR}} interface=$WGIF comment=$T
/ip route add dst-address="$RS/32" gateway=$WGIF comment=$T

/radius add service=wireless address=$RS secret="{{HOST_SECRET}}" authentication-port={{RADIUS_AUTH_PORT}} accounting-port={{RADIUS_ACCT_PORT}} timeout=3s comment=$T
/radius incoming set accept=yes port={{COA_PORT}}

/ip firewall address-list add list=$BL address=$WGN comment=$T
:foreach a in=[/ip address find where interface!=$T] do={
    :local ad [/ip address get $a address]
    :local nt [/ip address get $a network]
    :if ([:len [:find $ad "/"]] = 0) do={:set ad "$ad/32"}
    :local pl [:pick $ad ([:find $ad "/"] + 1) [:len $ad]]
    :do {/ip firewall address-list add list=$BL address="$nt/$pl" comment=$T} on-error={}
}

:local FI [/ip firewall filter find where chain=input]
:local FF [/ip firewall filter find where chain=forward]
:if ([:len $FI] > 0) do={
    /ip firewall filter add chain=input action=accept protocol=udp dst-port={{WG_LISTEN_PORT}} comment=$T place-before=[:pick $FI 0]
    /ip firewall filter add chain=input action=accept in-interface=$WGIF comment=$T place-before=[:pick $FI 0]
    /ip firewall filter add chain=input action=accept in-interface=$T protocol=udp dst-port=67 comment=$T place-before=[:pick $FI 0]
    /ip firewall filter add chain=input action=accept in-interface=$T protocol=icmp comment=$T place-before=[:pick $FI 0]
    /ip firewall filter add chain=input action=drop in-interface-list=$T comment=$T place-before=[:pick $FI 0]
} else={
    /ip firewall filter add chain=input action=accept protocol=udp dst-port={{WG_LISTEN_PORT}} comment=$T
    /ip firewall filter add chain=input action=accept in-interface=$WGIF comment=$T
    /ip firewall filter add chain=input action=accept in-interface=$T protocol=udp dst-port=67 comment=$T
    /ip firewall filter add chain=input action=accept in-interface=$T protocol=icmp comment=$T
    /ip firewall filter add chain=input action=drop in-interface-list=$T comment=$T
}
:if ([:len $FF] > 0) do={
    /ip firewall filter add chain=forward action=drop src-address=$NET dst-address-list=$BL comment=$T place-before=[:pick $FF 0]
    /ip firewall filter add chain=forward action=accept src-address=$NET comment=$T place-before=[:pick $FF 0]
} else={
    /ip firewall filter add chain=forward action=drop src-address=$NET dst-address-list=$BL comment=$T
    /ip firewall filter add chain=forward action=accept src-address=$NET comment=$T
}
/ip firewall nat add chain=srcnat action=masquerade src-address=$NET dst-address=!$NET comment=$T

/interface wireless security-profiles add name="$($T)-eap" mode=dynamic-keys authentication-types=wpa2-eap eap-methods=passthrough unicast-ciphers=aes-ccm group-ciphers=aes-ccm interim-update=1m radius-eap-accounting=yes comment=$T
:local N 0
:foreach w in=[/interface wireless find where master-interface=""] do={
    :local wn [/interface wireless get $w name]
    /interface wireless add name="$($T)-$($wn)" master-interface=$wn ssid=$SSID security-profile="$($T)-eap" disabled=no default-forwarding=no comment=$T
    /interface bridge port add bridge=$T interface="$($T)-$($wn)" horizon=1 comment=$T
    :set N ($N + 1)
}
:if ($N = 0) do={:log warning "cyber: no radios"}

:log info "cyber: {{HOST_ID}}"
:put "cyber ok - $SSID x$N"
