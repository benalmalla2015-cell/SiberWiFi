    public function transfer(Request $request): JsonResponse
    {
        $validator = Validator::make($request->all(), [
            'phone'  => 'required|string|max:20',
            'amount' => 'required|numeric|min:1',
        ]);

        if ($validator->fails()) {
            return response()->json(['success' => false, 'errors' => $validator->errors()], 422);
        }

        $sender = $request->user();

        // Only approved charging-point customers can transfer
        $point = ChargingPoint::where('user_id', $sender->id)
            ->where('is_active', true)
            ->where('is_approved', true)
            ->first();

        if (!$point) {
            return response()->json([
                'success' => false,
                'message' => 'لا يمكنك تحويل الرصيد. يجب أن تكون نقطة شحن معتمدة.',
            ], 403);
        }

        $recipient = User::where('phone', $request->phone)
            ->where('is_active', true)
            ->whereIn('type', ['customer'])
            ->first();

        if (!$recipient) {
            return response()->json([
                'success' => false,
                'message' => 'لم يتم العثور على عميل بهذا الرقم',
            ], 422);
        }

        if ($recipient->id === $sender->id) {
            return response()->json([
                'success' => false,
                'message' => 'لا يمكنك التحويل إلى نفسك',
            ], 422);
        }

        $amount = (float) $request->amount;

        if ((float) $sender->balance < $amount) {
            return response()->json([
                'success' => false,
                'message' => 'رصيدك غير كافٍ لإتمام عملية التحويل',
            ], 422);
        }

        $exchangeRate = $this->getTransferExchangeRate($sender->region_type, $recipient->region_type);
        $convertedAmount = round($amount * $exchangeRate, 2);

        \DB::transaction(function () use ($sender, $recipient, $amount, $convertedAmount, $exchangeRate) {
            $senderBefore = (float) $sender->balance;
            $recipientBefore = (float) $recipient->balance;

            $sender->balance = $senderBefore - $amount;
            $sender->available_balance = (float) $sender->available_balance - $amount;
            $sender->save();

            $recipient->balance = $recipientBefore + $convertedAmount;
            $recipient->available_balance = (float) $recipient->available_balance + $convertedAmount;
            $recipient->save();

            // Sender log
            WalletLog::create([
                'user_id'              => $sender->id,
                'counterparty_user_id' => $recipient->id,
                'type'                 => 'debit',
                'amount'               => $amount,
                'balance_before'       => $senderBefore,
                'balance_after'        => (float) $sender->balance,
                'description'          => "تحويل رصيد إلى {$recipient->name} ({$recipient->phone})",
                'reference_type'       => 'charging_point_transfer',
                'reference_id'         => $recipient->id,
            ]);

            // Recipient log
            WalletLog::create([
                'user_id'              => $recipient->id,
                'counterparty_user_id' => $sender->id,
                'type'                 => 'credit',
                'amount'               => $convertedAmount,
                'balance_before'       => $recipientBefore,
                'balance_after'        => (float) $recipient->balance,
                'description'          => "استلام رصيد من {$sender->name} ({$sender->phone})",
                'reference_type'       => 'charging_point_transfer',
                'reference_id'         => $sender->id,
            ]);

            // Notify both sides
            try {
                app(NotificationService::class)->send(
                    $sender,
                    'تم تحويل الرصيد',
                    "تم خصم مبلغ " . number_format($amount) . " ريال من رصيدك.",
                    ['type' => 'balance_transfer', 'direction' => 'out', 'to_user_id' => $recipient->id]
                );
                app(NotificationService::class)->send(
                    $recipient,
                    'تم استلام رصيد',
                    "تم إضافة مبلغ " . number_format($convertedAmount) . " ريال إلى رصيدك من {$sender->name}.",
                    ['type' => 'balance_transfer', 'direction' => 'in', 'from_user_id' => $sender->id, 'exchange_rate' => $exchangeRate]
                );
            } catch (\Throwable $e) {
                \Log::warning('Transfer notification failed: ' . $e->getMessage());
            }
        });

        return response()->json([
            'success'          => true,
            'message'          => 'تم تحويل الرصيد بنجاح',
            'amount'           => $amount,
            'converted_amount' => $convertedAmount,
            'exchange_rate'    => $exchangeRate !== 1.0 ? $exchangeRate : null,
            'recipient_name'   => $recipient->name,
            'recipient_phone'  => $recipient->phone,
            'new_balance'      => (float) $sender->fresh()->balance,
        ]);
    }

    private function getTransferExchangeRate(?string $from, ?string $to): float
    {
        if (!$from || !$to || $from === $to) {
            return 1.0;
        }
        $defaultRate = ($from === 'south' && $to === 'north') ? 1000.0 : 0.001;
        return (float) \App\Models\AppSetting::get('currency_exchange_rate', $defaultRate);
    }
